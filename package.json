    "next": "16.4.6",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "sass": "1.108.2",
    "stylelint": "17.16.0",
